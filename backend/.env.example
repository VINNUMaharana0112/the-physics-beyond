NODE_ENV=development
PORT=3000
PAYMENT_MODE=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/physics_beyond
# Comma-separated exact browser origins. Set to https://thephysicsbeyond.com,https://www.thephysicsbeyond.com in production.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me_with_a_distinct_webhook_secret
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
# Configure a trusted OIDC provider (Authorization Code + PKCE, public client).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_ADMIN_SUBJECTS=
ADMIN_SESSION_SECRET=
PUBLIC_API_URL=http://localhost:3000
OIDC_REDIRECT_URI=http://localhost:3000/api/admin/auth/callback
ADMIN_UI_URL=http://localhost:8080/admin/
# Must be an absolute directory outside the public website and web server document root.
PRIVATE_FILES_DIR=C:/physics-beyond-private-files
